+Eigen::VectorXd ExternalForcesObserver::simulatorGroundTruth(const mc_control::MCController & ctl)
+{
+  // mc_mujoco writes qfrc_constraint + qfrc_passive to realRobot immediately
+  // before the observer pipeline runs.
+  const auto & raw = ctl.realRobot(robot_).externalTorques();
+
+  if(raw.size() != nDof_)
+  {
+    mc_rtc::log::error_and_throw<std::runtime_error>(
+        "[ExternalForcesObserver] Simulator external torque has size {}, expected {}. "
+        "Enable external torques in mc_mujoco.",
+        raw.size(),
+        nDof_);
+  }
+
+  tau_ext_simulator_raw_ = raw;
+
+  if(resetSimulatorFilter_)
+  {
+    // Match the zero initial state used by the training low-pass filter.
+    tau_ext_simulator_filtered_.setZero();
+    resetSimulatorFilter_ = false;
+  }
+
+  constexpr double pi = 3.14159265358979323846;
+  const double alpha = std::exp(-2.0 * pi * simulatorFilterCutoffHz_ * dt());
+
+  tau_ext_simulator_filtered_ = alpha * tau_ext_simulator_filtered_
+                                + (1.0 - alpha) * tau_ext_simulator_raw_;
+
+  return tau_ext_simulator_filtered_;
+}
